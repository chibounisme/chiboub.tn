{
  "name": "chiboub.tn",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": ">=24.15.0 <25",
    "pnpm": ">=11 <12"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "typecheck:watch": "tsc --noEmit --watch",
    "build": "pnpm typecheck && node scripts/build.ts",
    "lint": "eslint . --cache --max-warnings 0",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "format": "eslint . --fix --max-warnings 0",
    "check": "pnpm lint && pnpm test && pnpm build",
    "audit:performance": "node scripts/lighthouse.ts",
    "preview": "vite preview --host 127.0.0.1 --port 5173 --strictPort",
    "prepare": "husky",
    "lint:staged": "lint-staged",
    "lint:commit": "commitlint"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@eslint/css": "2.0.0",
    "@eslint/js": "^10.0.1",
    "@eslint/markdown": "^8.0.3",
    "@html-eslint/eslint-plugin": "0.66.0",
    "@mdx-js/mdx": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@mdx-js/rollup": "^3.1.1",
    "@shikijs/rehype": "^4.4.3",
    "@stylistic/eslint-plugin": "5.10.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitest/coverage-v8": "^5.0.0",
    "chrome-launcher": "^1.2.1",
    "eslint": "^10.10.0",
    "eslint-plugin-better-tailwindcss": "4.7.0",
    "eslint-plugin-jsonc": "3.4.2",
    "eslint-plugin-mdx": "3.8.1",
    "eslint-plugin-yml": "3.8.1",
    "husky": "9.1.7",
    "jiti": "^2.7.0",
    "jsdom": "^30.0.1",
    "lighthouse": "13.4.1",
    "lint-staged": "17.5.1",
    "lucide-react": "^1.45.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-mdx-frontmatter": "^5.2.0",
    "tailwind-csstree": "^0.4.0",
    "tailwindcss": "^4.3.3",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.2.2",
    "vitest": "^5.0.0",
    "yaml": "^2.9.0"
  },
  "lint-staged": {
    "*.{ts,tsx,css,json,jsonc,md,mdx,yaml,yml,html,svg}": "eslint --fix --max-warnings 0 --no-warn-ignored"
  }
}
